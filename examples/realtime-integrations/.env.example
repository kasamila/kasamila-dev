# Copy to .env. Server secrets never belong in browser code.
PORT=8790
APP_ORIGIN=http://127.0.0.1:8790
KASAMILA_API_BASE=https://www.kasamila.com
KASAMILA_API_KEY=
KASAMILA_AVATAR_ID=
KASAMILA_TEMPLATE_CODE=001
KASAMILA_OUTPUT_MODE=original
KASAMILA_MEDIA_DESCRIPTOR=../geometry-runtime-web/config/your-media.json
# openai | gemini | qwen | ten | bridge | grok | elevenlabs | vapi | deepgram | hume | dify
PROVIDER=openai
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=
# This example explicitly uses the Qwen3-Omni Flash legacy session schema.
# Do not point it at Qwen3.5 without also adapting the session schema.
DASHSCOPE_API_KEY=
QWEN_REALTIME_MODEL=qwen3-omni-flash-realtime
QWEN_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
TEN_WS_URL=ws://127.0.0.1:8002
# For bridge mode (Doubao official-demo hook / custom server PCM producer).
# Keep private and run only on loopback. Use your own authenticated server in production.
BRIDGE_SECRET=
BRIDGE_INPUT_RATE=16000
# New voice agents: configure only your chosen provider. No keys in client code.
XAI_API_KEY=
XAI_VOICE_MODEL=grok-voice-latest
XAI_VOICE=eve
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Configure the existing ElevenLabs agent for PCM input/output in its dashboard.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
# Existing assistant is reused. GPT-Live assistants require 24000 explicitly.
VAPI_SAMPLE_RATE=16000
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_LLM_MODEL=gpt-4o-mini
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
HUME_API_KEY=
HUME_SECRET_KEY=
HUME_CONFIG_ID=
DIFY_API_BASE=https://api.dify.ai/v1
DIFY_API_KEY=
# Enable STT/TTS on the existing Chat/Chatflow app attached to your knowledge base.
AGENT_LANGUAGE=en
AGENT_INSTRUCTIONS=You are a helpful assistant.
# Optional live tools. Never paste these credentials into a Browser Source URL.
STREAMLABS_SOCKET_TOKEN=
OBS_WS_URL=
OBS_WS_PASSWORD=
