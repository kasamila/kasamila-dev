{% assign assistant_locale = request.locale.iso_code | split: '-' | first %}
{% if block.settings.demo_id != blank %}
<div id="kasamila-assistant-{{ block.id }}"></div>
<script type="module">
import {mountAssistant} from 'https://kasamila.com/portal/apps/shopify/widget.js?v=2';
const target=document.getElementById({{ 'kasamila-assistant-' | append: block.id | json }});
const widget=mountAssistant(target,{store:{{ block.settings.demo_id | json }},language:{{ assistant_locale | json }},floating:true});
document.addEventListener('shopify:section:unload',event=>{if(event.target.contains(target))widget.destroy();});
</script>
{% endif %}
{% schema %}
{"name":"Kasamila shop assistant","target":"section","settings":[{"type":"text","id":"demo_id","label":"Portal demo store ID","default":"kasamila"}]}
{% endschema %}
